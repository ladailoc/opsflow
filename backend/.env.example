# Copy values into your shell or an untracked .env file; Spring Boot does not read this file automatically.
# Local PostgreSQL may use sslmode=disable. Supabase should use SSL and a verified server certificate.
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=verify-full
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
SERVER_PORT=8080
